{
  "name": "imageboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "lint": "eslint .",
    "start": "next start",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "db:generate": "npx drizzle-kit generate",
    "dev:setup": "npm run db:reset && npm run db:migrate",
    "dev:fresh": "npm run dev:setup && npm run dev",
    "generate-user-seed": "tsx scripts/generate-user-seed.ts",
    "seed:load-test": "tsx --env-file=.env scripts/seed-load-test.ts 1 5000 100 6",
    "test": "tsx --test 'lib/**/__tests__/*.test.ts'"
  },
  "dependencies": {
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@sentry/nextjs": "^10.62.0",
    "@vercel/analytics": "1.3.1",
    "@vercel/speed-insights": "^2.1.0",
    "argon2-wasm-edge": "^1.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "lucia": "^3.2.2",
    "lucide-react": "^0.454.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "posthog-js": "^1.395.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
