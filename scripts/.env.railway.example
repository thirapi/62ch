# Railway Auto-Restart configuration
# Copy this file to .env.railway and fill in your values
# Usage: cp scripts/.env.railway.example scripts/.env.railway

# Workspace token (RECOMMENDED over account token for API mutations)
# Create at: https://railway.com/account/tokens
RAILWAY_TOKEN=

# Get IDs via Railway dashboard: Ctrl/Cmd+K -> Copy Project/Environment ID
# or from URL: https://railway.com/project/<PROJECT_ID>/service/<SERVICE_ID>?environmentId=<ENV_ID>
PROJECT_ID=
ENVIRONMENT_ID=

# Optional: comma-separated service IDs to restart.
# Leave empty to auto-discover ALL services in the project.
SERVICES=
