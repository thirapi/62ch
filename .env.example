# Database (PostgreSQL, e.g. the Supabase connection pooler)
# WARNING: npm run db:reset / dev:setup DROP the whole schema of this database.
# Use a separate development database, never production.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Cloudinary (image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Public site URL (metadata, sitemap, canonical links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Client IP (bans / rate limiting)
# Header set by YOUR edge proxy that clients cannot forge. Railway overwrites
# X-Real-IP on every request. CF-Connecting-IP is trusted automatically only
# when the request comes from a real Cloudflare edge address.
CLIENT_IP_HEADER=x-real-ip

# PostHog (optional analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AI moderation (optional, Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=your-gemini-api-key,your-gemini-api-key2
# GEMINI_MODELS=gemini-2.5-flash

# Only used by `npm run generate-user-seed` (prints SQL for the first admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
