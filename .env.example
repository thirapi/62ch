# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Moderation
MODERATOR_TOKEN=your-moderator-token

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AI Moderation
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=your-gemini-api-key,your-gemini-api-key2


NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Client IP (bans / rate limiting)
# Header set by YOUR edge proxy that clients cannot forge. Railway overwrites
# X-Real-IP on every request. CF-Connecting-IP is trusted automatically only
# when the request comes from a real Cloudflare edge address.
CLIENT_IP_HEADER=x-real-ip
